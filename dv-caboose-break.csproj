<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <AssemblyName>DVCabooseBreak</AssemblyName>
    <GameDir Condition="'$(GameDir)' == ''">W:\SteamLibrary\steamapps\common\Derail Valley</GameDir>
    <Managed>$(GameDir)\DerailValley_Data\Managed</Managed>
    <AutomaticallyUseReferenceAssemblyPackages>false</AutomaticallyUseReferenceAssemblyPackages>
    <FrameworkPathOverride>C:\Windows\Microsoft.NET\Framework64\v4.0.30319</FrameworkPathOverride>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <RestoreSources></RestoreSources>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="tools\**\*.cs" />
    <Reference Include="netstandard"><HintPath>$(Managed)\netstandard.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="$(Managed)\*.dll" Exclude="$(Managed)\System*.dll;$(Managed)\mscorlib.dll;$(Managed)\netstandard.dll;$(Managed)\Microsoft.CSharp.dll;$(Managed)\Mono*.dll;$(Managed)\I18N*.dll"><Private>false</Private></Reference>
    <Reference Include="0Harmony"><HintPath>$(Managed)\UnityModManager\0Harmony.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityModManager"><HintPath>$(Managed)\UnityModManager\UnityModManager.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>
</Project>
